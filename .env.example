# ---------------------------------------------------------------------------
# Tello Printing Center — public runtime configuration
#
# Copy this file to `.env.local` and fill in real values. Every value is
# optional: the UI shows a "not configured" state rather than inventing
# contact details or generating broken links.
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, JSON-LD, sitemap and WhatsApp messages.
# Include the protocol, without a trailing slash.
NEXT_PUBLIC_SITE_URL="https://example.com"

# WhatsApp business number in international format. Digits only or common
# separators are accepted; the app normalizes a leading `+` or `00`.
# Leave empty to disable WhatsApp ordering (the UI explains how to configure it).
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Public contact channels. Leave empty to hide them.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_ADDRESS_EN=""
NEXT_PUBLIC_CONTACT_ADDRESS_AR=""

# Optional social profiles. Only valid http(s) URLs are rendered.
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_TELEGRAM=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_X=""

# Optional licensed GLB/GLTF replacement for the procedural homepage hero
# printer. Leave empty to use the built-in original model. See
# public/models/README.md for optimization and licensing guidance.
NEXT_PUBLIC_HERO_PRINTER_MODEL=""
