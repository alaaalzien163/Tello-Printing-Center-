# ---------------------------------------------------------------------------
# Tello Printing Center — public runtime configuration
#
# Copy this file to `.env.local` and fill in real values. Every value is
# optional: the UI shows a "not configured" state rather than inventing
# contact details or generating broken links.
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, JSON-LD, sitemap, robots.txt and WhatsApp
# messages. Optional: see "Deployment origins" in README.md.
#
#   Local development   -> http://localhost:3000
#   Vercel Preview      -> https://$VERCEL_URL (or the value below)
#   Vercel Production   -> https://www.telloprintingcenter.com (fixed)
#
# Production builds reject any other value. Preview builds reject the
# Production origin, `http://` origins and localhost. Include the protocol and
# do not add a trailing slash or path. Leave empty to use the defaults above.
NEXT_PUBLIC_SITE_URL=""

# WhatsApp business number in international format. Digits only or common
# separators are accepted; the app normalizes a leading `+` or `00`.
# Leave empty to disable WhatsApp ordering (the UI explains how to configure it).
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Public contact channels. Leave empty to hide them.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_ADDRESS_EN=""
NEXT_PUBLIC_CONTACT_ADDRESS_AR=""

# Optional social profiles. Only valid http(s) URLs are rendered.
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_TELEGRAM=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_X=""

# Supabase Auth. The publishable key is safe for the browser. Never add a
# service_role or secret key to this file or to any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# ---------------------------------------------------------------------------
# Public print requests (server-only secrets)
# ---------------------------------------------------------------------------
# Privileged server key used only by the public request API to create rows and
# sign uploads after validation. Use a Supabase secret key, never a
# NEXT_PUBLIC_* value, and never expose it to the browser.
SUPABASE_SECRET_KEY=""

# HMAC salt for the IP rate limiter. Use at least 16 random characters. Raw IP
# addresses are never stored; rotating this value resets the ledger.
PRINT_REQUEST_RATE_LIMIT_SECRET=""

# Playwright authentication fixtures and destructive test settings belong in
# `.env.test.local`, not `.env.local`. See `.env.test.example`. Tests that need
# Staging skip when that file is absent.

# Non-Vercel production only: force `Secure` on Supabase session cookies.
# Vercel Production/Preview set this automatically from VERCEL_ENV.
# SUPABASE_COOKIE_SECURE="true"
