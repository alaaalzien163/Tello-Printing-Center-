# ---------------------------------------------------------------------------
# Tello Printing Center — Staging-only Playwright configuration
#
# Copy to `.env.test.local` (gitignored). Never put Production credentials in
# this file. The E2E write guard refuses to run destructive tests unless the
# configured URL matches E2E_EXPECTED_STAGING_PROJECT_REF and differs from
# E2E_PRODUCTION_PROJECT_REF.
# ---------------------------------------------------------------------------

# Staging Supabase project (project reference is the 20-character host label).
NEXT_PUBLIC_SUPABASE_URL="https://your-staging-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_staging_placeholder"

# Staging-only server secret used by the print-request API. Never reuse the
# Production value, and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# HMAC salt for the rate limiter. Use a Staging-only value of 16+ characters.
PRINT_REQUEST_RATE_LIMIT_SECRET=""

# Explicit opt-in for tests that create/update/delete rows or upload objects.
E2E_ALLOW_DATABASE_WRITES="false"

# The project reference that destructive tests are allowed to target.
E2E_EXPECTED_STAGING_PROJECT_REF=""

# The Production project reference. Used only to refuse writes; it is never
# used as a target.
E2E_PRODUCTION_PROJECT_REF=""

# Staging authentication fixtures. Create dedicated Staging users; never use a
# Production administrator account here.
# E2E_ADMIN_EMAIL=""
# E2E_ADMIN_PASSWORD=""
# E2E_NON_ADMIN_EMAIL=""
# E2E_NON_ADMIN_PASSWORD=""

# Additional destructive/slow test opt-ins (all default to off).
# E2E_PRINT_REQUEST_UPLOADS="0"
# E2E_PRINT_REQUEST_RATE_LIMIT="0"
# E2E_PRINT_REQUEST_LIVE_UPLOAD="0"
